diff --git a/tools/build/parseText.py b/tools/build/parseText.py
index 74e0b278..44dd627f 100755
--- a/tools/build/parseText.py
+++ b/tools/build/parseText.py
@@ -10,6 +10,8 @@ import sys
 import os
 import io
 import yaml
+import json
+import unicodedata
 
 sys.path.append(os.path.dirname(__file__) + '/..')
 from common import *
@@ -39,6 +41,8 @@ useVwf = False
 
 EUText = False
 
+greekMapPath = None
+
 while len(sys.argv) > argIndex:
     s = sys.argv[argIndex]
     argIndex+=1
@@ -46,6 +50,30 @@ while len(sys.argv) > argIndex:
         useVwf = True
     if s == '--EU':
         EUText = True
+    if s == '--greek-map':
+        greekMapPath = sys.argv[argIndex]
+        argIndex+=1
+
+# Greek support: map produced by greek_font.py ("U+XXXX" -> tile byte)
+GREEK_MAP = {}
+GREEK_SLOTS = set()
+GREEK_FOLD_GRAVE = False
+if greekMapPath is not None:
+    with open(greekMapPath, 'r', encoding='utf-8') as f:
+        _g = json.load(f)
+    GREEK_MAP = {chr(int(k[2:], 16)): v for k, v in _g['map'].items()}
+    GREEK_SLOTS = set(GREEK_MAP.values())
+    GREEK_FOLD_GRAVE = _g.get('fold_grave', False)
+
+def normalizeGreek(text):
+    if not GREEK_MAP:
+        return text
+    text = unicodedata.normalize('NFC', text)
+    for a in ('\u1fbd', '\u2019', '\u02bc'):
+        text = text.replace(a, "'")
+    if GREEK_FOLD_GRAVE:
